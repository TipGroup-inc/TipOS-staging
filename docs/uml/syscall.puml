@startuml
' moe moe kyun <3
' TipOS — fluxo de uma syscall (int 0x80, convenção XNU)
' rax = número, rdi/rsi/rdx/rcx = args, retorno em rax

title Syscall — caminho do ring 3 ao ring 0

skinparam shadowing false
skinparam defaultFontName "SansSerif"
skinparam sequenceMessageAlign center

participant "userland\n(libc própria)" as ul
participant "syscall_entry.asm" as entry
participant "syscall.c\ndispatcher" as disp
participant "handler\n(exit, read, write,\nmmap, disp_flush...)" as h
participant "syscall_linux.zig\n(tradução)" as trl
participant "process.c\n(scheduler)" as sched

ul -> ul : int 0x80\n(rax=nº, rdi/rsi/rdx/rcx=args)
ul -> entry : CPU entra em ring 0\n(swapgs se TLS, save regs)
activate entry
entry -> disp : dispatch(rax)
activate disp
disp -> trl : número Linux?\n(se veio de ELF musl)
trl -> disp : mapeia p/ número nativo
disp -> h : handler(args)
activate h
h -> sched : se bloquear\n(read, waitpid...)
sched --> h : desbloqueia (RR)
h --> disp : retorno em rax
deactivate h
deactivate disp
entry -> ul : iretq (ring 3)\nFS.base restaurado
deactivate entry
@enduml
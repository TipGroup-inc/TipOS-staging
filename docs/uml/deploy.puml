@startuml
' moe moe kyun <3
' TipOS — deploy: como o bicho roda (build → QEMU)
' make all → TipOS.iso; make userland → disk.img; make run → QEMU

title Deploy — build e execução

skinparam shadowing false
skinparam defaultFontName "SansSerif"

node "Host Linux" as host {
    folder "OvsbMk/\n(kernel.elf)" as ksrc
    folder "src/userland/\n(libc, graphy)" as usrc
    folder "../disp, ../term\n(repos irmãos)" as isrc
    artifact "make all" as m1
    artifact "make userland" as m2
    m1 --> ksrc
    m2 --> usrc
    m2 --> isrc
}

node "QEMU\n(qemu-system-x86_64)" as qemu {
    artifact "TipOS.iso\n(GRUB2 + kernel.elf)" as iso
    artifact "disk.img\n(FAT32 64MB)" as disk
    node "TipOS\n(ring 0 + ring 3)" as tipos {
    }
}

ksrc --> iso : grub-mkrescue
usrc --> disk : mcopy ::/BIN/...
isrc --> disk : mcopy (DISP, TERM)
qemu --> iso : -cdrom
qemu --> disk : -drive file=disk.img
iso --> tipos : boot
disk --> tipos : FAT32 (leitura/escrita)

artifact "make run" as run
run --> qemu : -m 512M -serial stdio
artifact "make run-test" as runtest
runtest --> qemu : headless, log em\n/tmp/tipos-boot.log
@enduml
@startuml
' moe moe kyun <3
' TipOS — exec de binário ELF64 (musl static PIE, Linux compat)
' shell "exec HELLO" → elf64.zig → child PML4 → ring 3

title Exec de ELF64 (Linux x86-64 compat)

skinparam shadowing false
skinparam defaultFontName "SansSerif"
skinparam sequenceMessageAlign center

participant "shell.c\n(cmd_exec)" as sh
participant "fat32.c" as fs
participant "mach_o.c" as macho
participant "elf64.zig" as elf
participant "memory.c\n(clone_identity_tables)" as mem
participant "process.c" as proc

sh -> sh : exec <arquivo>
sh -> fs : lê arquivo do FAT32\n(magic 0x7F 'ELF'?)
alt é Mach-O
    sh -> macho : carrega Mach-O 64-bit\n(0x2000000)
else é ELF64
    sh -> elf : elf64_load_into_pml4()
    activate elf
    elf -> elf : valida headers, PT_LOAD\n2MB hugepages (PML4 child)
    elf -> mem : child PML4\n(U/S bits controlados)
    elf -> proc : setup_linux_user_stack()\nargc/argv/envp/auxv\n(AT_RANDOM, AT_PHDR...)
    proc -> proc : spawn processo (PCB)\nFS.base p/ TLS
    elf --> sh : executa ring 3
    deactivate elf
end
sh -> sh : "Hello from musl ELF!"\n(se for o HELLO demo <3)
@enduml